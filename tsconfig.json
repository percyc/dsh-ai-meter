{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "src",
    "tests"
  ],
  "exclude": [
    "tests/browser"
  ]
}
